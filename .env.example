# Configuración general. Para Docker, las URLs internas de Qdrant y Memgraph las define Compose.
APP_NAME=Axiz Adaptive RAG Payments
APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:4200

# Vector store y embeddings locales. No requieren token.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=axiz_payment_chunks
RAGLIGHT_COLLECTION=axiz_payment_raglight
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384

# Grafo local. La imagen usada en la PoC no configura autenticación.
MEMGRAPH_URI=bolt://localhost:7687
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# Generación. El modo extractive permite levantar la PoC sin credenciales externas.
LLM_PROVIDER=extractive
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSION=1536

# GLM-OCR. En MaaS solo hace falta ZHIPU_API_KEY cuando se procesa un documento que requiere OCR.
# GLM_OCR_API_URL se deja vacío en MaaS para que el SDK use su endpoint configurado.
GLM_OCR_MODE=maas
GLM_OCR_API_URL=
ZHIPU_API_KEY=
OCR_MIN_TEXT_CHARS=120

# RAGLight funciona con embeddings públicos/locales y no requiere API key.
RAGLIGHT_ENABLED=true
RAGLIGHT_SERVICE_URL=http://localhost:8010
RAGLIGHT_TIMEOUT_SECONDS=600

# LightRAG necesita LLM + embeddings. Con el adapter actual usa un endpoint OpenAI-compatible.
# Si no se configura OPENAI_API_KEY, LightRAG aparece como no disponible sin impedir el resto de la PoC.
LIGHTRAG_ENABLED=true
LIGHTRAG_WORKDIR=.runtime/lightrag

DATASETS_DIR=datasets/sample_documents
