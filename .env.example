# ============================================================================
# Adaptive RAG Payments - variables de entorno
# ============================================================================
# Copiar este archivo como .env y modificar solo lo necesario:
#   cp .env.example .env
#
# Los valores de este archivo son ejemplos/valores por defecto de la PoC.
# Docker Compose sobrescribe algunas URLs con nombres internos de servicio
# (por ejemplo qdrant, memgraph, raglight-service y glm-ocr).
# No guardar credenciales reales en el repositorio.
# ============================================================================

# ----------------------------------------------------------------------------
# Aplicación / API
# ----------------------------------------------------------------------------
# Nombre libre mostrado por la aplicación.
# Ejemplo: Axiz Adaptive RAG Payments
APP_NAME=Axiz Adaptive RAG Payments

# Entorno lógico. Valores habituales: local | docker | dev | test.
# Docker Compose fuerza APP_ENV=docker dentro del backend.
APP_ENV=local

# Host de escucha de FastAPI.
# 0.0.0.0 = accesible desde otras interfaces/contenedores.
# 127.0.0.1 = solo loopback local.
API_HOST=0.0.0.0

# Puerto HTTP del backend. Valor por defecto de la PoC: 8000.
API_PORT=8000

# Orígenes permitidos por CORS.
# Acepta CSV: http://localhost:4200,http://localhost:4300
# o JSON: ["http://localhost:4200","http://localhost:4300"]
CORS_ORIGINS=http://localhost:4200

# ----------------------------------------------------------------------------
# Hugging Face / embeddings / Qdrant
# ----------------------------------------------------------------------------
# Token opcional de Hugging Face. Vacío funciona con modelos públicos,
# pero un token puede evitar límites anónimos de descarga.
# Formato esperado si se usa: hf_...
HF_TOKEN=

# URL de Qdrant para ejecución local fuera de Docker.
# En Docker, Compose la sobrescribe por http://qdrant:6333.
QDRANT_URL=http://localhost:6333

# Nombre de la colección vectorial principal del backend.
QDRANT_COLLECTION=axiz_payment_chunks

# Nombre de la colección usada por RAGLight.
RAGLIGHT_COLLECTION=axiz_payment_raglight

# Modelo de embeddings usado por RAGLight.
# El valor actual genera vectores de 384 dimensiones.
RAGLIGHT_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Provider de embeddings del backend principal.
# En esta versión el backend usa FastEmbed; mantener: fastembed.
EMBEDDING_PROVIDER=fastembed

# Modelo de embeddings usado por FastEmbed en Native/Hybrid/GraphRAG.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Dimensión del embedding anterior. Debe coincidir con el modelo configurado.
# paraphrase-multilingual-MiniLM-L12-v2 => 384.
EMBEDDING_DIMENSION=384

# ----------------------------------------------------------------------------
# Memgraph
# ----------------------------------------------------------------------------
# URI Bolt para ejecución local.
# En Docker, Compose la sobrescribe por bolt://memgraph:7687.
MEMGRAPH_URI=bolt://localhost:7687

# La imagen de Memgraph usada por esta PoC no requiere autenticación.
# Dejar vacíos salvo que se cambie la configuración de Memgraph.
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# ----------------------------------------------------------------------------
# Generación de respuestas
# ----------------------------------------------------------------------------
# Modos soportados por el backend:
#   extractive = no usa un LLM externo; responde con evidencia recuperada.
#   openai     = usa un endpoint OpenAI-compatible si hay API key.
LLM_PROVIDER=extractive

# Clave del proveedor OpenAI-compatible. Vacía en modo extractive.
OPENAI_API_KEY=

# URL base del proveedor OpenAI-compatible.
# Puede apuntar a OpenAI o a otro servidor que implemente la misma API.
OPENAI_BASE_URL=https://api.openai.com/v1

# Modelo de generación cuando LLM_PROVIDER=openai.
OPENAI_MODEL=gpt-5-mini

# Modelo de embeddings usado específicamente por LightRAG.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Dimensión correspondiente a OPENAI_EMBEDDING_MODEL.
# Para text-embedding-3-small la PoC usa 1536.
OPENAI_EMBEDDING_DIMENSION=1536

# ----------------------------------------------------------------------------
# GLM-OCR
# ----------------------------------------------------------------------------
# Modos soportados por el adapter:
#   selfhosted = usa el contenedor local vLLM de la PoC.
#   maas       = usa el servicio remoto y requiere ZHIPU_API_KEY.
# Docker Compose fuerza selfhosted para la ruta local.
GLM_OCR_MODE=selfhosted

# Endpoint OpenAI-compatible del runtime GLM-OCR.
# Local fuera de Docker: http://localhost:8080/v1/chat/completions
# En Docker, Compose usa: http://glm-ocr:8080/v1/chat/completions
GLM_OCR_API_URL=http://localhost:8080/v1/chat/completions

# Nombre servido por vLLM (--served-model-name).
GLM_OCR_MODEL=glm-ocr

# Compatibilidad con el SDK en modo MaaS/legacy.
# En selfhosted v20 el backend NO carga PP-DocLayoutV3 localmente: llama vLLM directamente.
GLM_OCR_LAYOUT_DEVICE=cpu
GLM_OCR_MAX_WORKERS=1

# Timeout por request al servidor GLM-OCR, en segundos.
# 600 da margen a GPUs lentas y al primer warm-up.
GLM_OCR_REQUEST_TIMEOUT_SECONDS=600

# Máximo de tokens generados por cada llamada directa a GLM-OCR/vLLM.
# Perfil 4 GB / max-model-len 8192: 2048 deja margen al prompt visual (~4968 tokens
# en la muestra incluida) sin forzar una salida excesiva.
# En GPUs con más VRAM y mayor max-model-len puede aumentarse.
GLM_OCR_MAX_TOKENS=2048

# Diagnóstico CUDA/vLLM. Mantener estos valores en ejecución normal.
# CUDA_LAUNCH_BLOCKING=1 solo debe usarse temporalmente para localizar errores CUDA;
# hace las operaciones síncronas y reduce el rendimiento.
CUDA_LAUNCH_BLOCKING=0
# INFO = ejecución normal; DEBUG = diagnóstico detallado de vLLM.
VLLM_LOGGING_LEVEL=INFO

# Política OCR por defecto:
#   auto    = imágenes -> GLM-OCR; documentos -> Docling y fallback a GLM-OCR.
#   glm     = fuerza GLM-OCR.
#   docling = fuerza Docling y no usa GLM-OCR.
OCR_POLICY=auto

# Cantidad mínima de caracteres extraídos por Docling para considerar suficiente
# el documento antes de hacer fallback a GLM-OCR en modo auto.
OCR_MIN_TEXT_CHARS=120

# Solo se usa si GLM_OCR_MODE=maas. En selfhosted debe permanecer vacío.
ZHIPU_API_KEY=

# ----------------------------------------------------------------------------
# RAGLight
# ----------------------------------------------------------------------------
# true = habilita el adapter RAGLight; false = lo deshabilita.
RAGLIGHT_ENABLED=true

# URL del microservicio RAGLight para ejecución local.
# En Docker, Compose la sobrescribe por http://raglight-service:8010.
RAGLIGHT_SERVICE_URL=http://localhost:8010

# Timeout de llamadas backend -> RAGLight, en segundos.
RAGLIGHT_TIMEOUT_SECONDS=600

# ----------------------------------------------------------------------------
# LightRAG
# ----------------------------------------------------------------------------
# true = intenta habilitar LightRAG.
# Para estar realmente disponible necesita el proveedor OpenAI-compatible
# y las variables OPENAI_* correctas.
# Si está disponible, dataset-seed puede tardar varios minutos porque construye
# su índice directamente en un proceso aislado; el backend HTTP sigue libre.
LIGHTRAG_ENABLED=true

# Directorio de trabajo/persistencia local de LightRAG.
LIGHTRAG_WORKDIR=.runtime/lightrag

# Tiempo máximo por indexación/consulta LightRAG. Evita requests HTTP indefinidos
# cuando el proveedor OpenAI-compatible o la extracción de grafo tarda demasiado.
LIGHTRAG_TIMEOUT_SECONDS=300

# ----------------------------------------------------------------------------
# Dataset de ejemplo
# ----------------------------------------------------------------------------
# Carpeta con los documentos que carga el bootstrap automático.
DATASETS_DIR=datasets/sample_documents

# ----------------------------------------------------------------------------
# Optimización OCR para GPU de baja VRAM
# ----------------------------------------------------------------------------
# Lado máximo antes de enviar una imagen a GLM-OCR. La muestra 1654x2339 se
# reduce conservando aspecto; 1400 es el perfil base validable para GTX 1650.
GLM_OCR_IMAGE_MAX_SIDE=1400

# Límite de píxeles después del resize. Reduce tokens visuales y latencia.
GLM_OCR_IMAGE_MAX_PIXELS=1600000

# Calidad JPEG usada por el preprocesado antes de vLLM.
GLM_OCR_IMAGE_QUALITY=92

# Escala de rasterización de páginas PDF antes del resize final.
GLM_OCR_PDF_SCALE=1.5

# ----------------------------------------------------------------------------
# Retrieval post-processing: candidatos, deduplicación y reranking
# ----------------------------------------------------------------------------
# Cantidad de candidatos = max(top_k * multiplier, minimum), con tope interno.
RETRIEVAL_CANDIDATE_MULTIPLIER=4
RETRIEVAL_CANDIDATE_MINIMUM=12

# Cosine similarity a partir de la cual dos chunks se consideran equivalentes.
SEMANTIC_DEDUP_THRESHOLD=0.94

# Pesos del reranker común. Se recomienda que sumen 1.0.
RERANK_SEMANTIC_WEIGHT=0.65
RERANK_LEXICAL_WEIGHT=0.20
RERANK_ORIGINAL_WEIGHT=0.10
RERANK_ENTITY_WEIGHT=0.05

# ----------------------------------------------------------------------------
# Ingesta asíncrona
# ----------------------------------------------------------------------------
# Workers internos del backend. Para GTX 1650 mantener 1 evita competir por GPU.
INGESTION_JOB_WORKERS=1
INGESTION_JOB_QUEUE_SIZE=32
JOBS_DIR=.runtime/jobs
