APP_NAME=Axiz Adaptive RAG Payments
APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:4200

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=axiz_payment_chunks
RAGLIGHT_COLLECTION=axiz_payment_raglight
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384

MEMGRAPH_URI=bolt://localhost:7687
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

LLM_PROVIDER=extractive
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSION=1536

GLM_OCR_MODE=maas
GLM_OCR_API_URL=
ZHIPU_API_KEY=
OCR_MIN_TEXT_CHARS=120

RAGLIGHT_ENABLED=true
LIGHTRAG_ENABLED=true
LIGHTRAG_WORKDIR=.runtime/lightrag
DATASETS_DIR=datasets/sample_documents
