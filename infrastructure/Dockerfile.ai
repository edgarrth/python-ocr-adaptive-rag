# syntax=docker/dockerfile:1.7

FROM python:3.12-slim-bookworm AS ai-base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential curl libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --upgrade pip setuptools wheel

# Ambos stacks usan PyTorch. Se instala una sola capa CPU para evitar que pip
# descargue las dependencias CUDA/NVIDIA de la distribución estándar de PyPI.
ARG TORCH_VERSION=2.14.0+cpu
ARG TORCHVISION_VERSION=0.29.0+cpu
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install \
      --index-url https://download.pytorch.org/whl/cpu \
      "torch==${TORCH_VERSION}" \
      "torchvision==${TORCHVISION_VERSION}"

FROM ai-base AS backend

COPY pyproject.toml /app/pyproject.toml
COPY backend /app/backend
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install .
COPY datasets /app/datasets

EXPOSE 8000
CMD ["python", "-m", "uvicorn", "pe.axiz.payment_knowledge.main:app", "--host", "0.0.0.0", "--port", "8000"]

FROM ai-base AS raglight

COPY raglight_service/pyproject.toml /app/pyproject.toml
COPY raglight_service/src /app/src
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install . \
    && python -c "from raglight.config.settings import Settings; from raglight.rag.builder import Builder; import importlib.metadata as m; print('RAGLight compatibility:', {p: m.version(p) for p in ['raglight','langgraph','langgraph-prebuilt','langgraph-checkpoint','langgraph-sdk','qdrant-client']})"

EXPOSE 8010
CMD ["python", "-m", "uvicorn", "pe.axiz.raglight_service.main:app", "--host", "0.0.0.0", "--port", "8010"]
